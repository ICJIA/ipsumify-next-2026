{
  "name": "ipsumify",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt build && node scripts/write-csp.mjs",
    "build:cli": "node packages/ipsumify/build.mjs",
    "build:diagrams": "node scripts/build-diagrams.mjs",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "yarn test:lint && yarn test:types && yarn test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:lint": "eslint .",
    "test:types": "nuxt typecheck",
    "test:all": "yarn test:lint && yarn test:types && yarn test:unit && yarn build && yarn build:cli"
  },
  "dependencies": {
    "@nuxt/ui": "^4",
    "@nuxtjs/seo": "^3.4.0",
    "marked": "^17.0.2",
    "nuxt": "^4",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@iconify-json/simple-icons": "^1.2.102",
    "@nuxt/eslint": "1.17.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "happy-dom": "^21",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "yarn@1.22.22"
}
